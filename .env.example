# =============================================================================
# AI RCA Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# --- Logging & Debugging ---
LOG_LEVEL=INFO                          # DEBUG, INFO, WARNING, ERROR, CRITICAL
SCAN_INTERVAL=5                         # Seconds between container discovery scans

# --- AI Provider Configuration ---
# Supported: ollama, lm_studio, openai, openrouter, azure_openai, anthropic, google_gemini
AI_PROVIDER=ollama

# Ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# LM Studio
LM_STUDIO_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=local-model

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# OpenRouter (20+ free models — no credit card needed)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# --- Notification: Google Chat ---
GOOGLE_CHAT_WEBHOOK_URL=

# --- Notification: SMTP Email ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=rcagent@example.com
EMAIL_TO=devops@example.com

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rcagent
POSTGRES_PASSWORD=rcagent_secret
POSTGRES_DB=rcagent

# --- Test Error Generator (docker compose profile: test) ---
# Used by the error-generator container and scripts/test_container_error_pipeline.sh
# ERROR_MODE=burst|loop  (burst: one finite burst then exit; loop: burst every BURST_INTERVAL_SECONDS)
ERROR_MODE=burst
ERROR_INTERVAL_SECONDS=1.5
ERROR_BURSTS=1
BURST_INTERVAL_SECONDS=300

# --- Deployment Environment ---
# Where the monitored workloads run. Controls which remediation commands the AI
# may suggest in RCA reports (e.g. no kubectl/helm unless ENVIRONMENT_TYPE=kubernetes).
# Supported: docker-compose, docker, kubernetes, vm, bare-metal, other
ENVIRONMENT_TYPE=docker-compose

# --- Analysis Configuration ---
# Serial analysis queue: AI RCA requests are processed ONE AT A TIME with this
# gap between calls (protects provider rate limits, e.g. OpenRouter free tier).
AI_ANALYSIS_INTERVAL=5
# Max seconds for a single AI analysis before it is abandoned (fallback used).
AI_ANALYSIS_TIMEOUT=150
MAX_LOG_LINES=200                       # Lines before error to include in analysis
MAX_LOG_LINES_AFTER=50                  # Lines after error to include
RETENTION_DAYS=30                       # Days to keep historical data
BATCH_ANALYSIS_INTERVAL=60              # Seconds between batch analysis cycles
DEDUPLICATION_WINDOW=300                # Seconds to suppress duplicate alerts

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# --- Monitoring ---
CONTAINER_SCAN_INTERVAL=5              # Seconds between container discovery scans
LOG_POLL_INTERVAL=1                    # Seconds between log poll cycles for each container
MAX_CONTAINERS=1000                    # Maximum containers to monitor simultaneously

# --- Custom Log File Monitoring (non-Docker applications) ---
# Monitor log files of applications running OUTSIDE Docker containers.
# When running the agent via Docker Compose, the host directory below is
# mounted to /host-logs inside the container (see docker-compose.yml).
CUSTOM_LOG_DIR=./logs                 # Host directory mounted to /host-logs
# Comma-separated paths (inside the container) to log files to tail.
# Example: CUSTOM_LOG_FILES=/host-logs/app.log,/host-logs/error.log
CUSTOM_LOG_FILES=
# Optional comma-separated display names (must match CUSTOM_LOG_FILES order)
# Example: CUSTOM_LOG_NAMES=myapp,myapp-errors
CUSTOM_LOG_NAMES=
LOG_FILE_POLL_INTERVAL=0.5            # Seconds between file reads while tailing
LOG_FILE_TAIL_LINES=100               # Existing lines seeded into buffer on start
